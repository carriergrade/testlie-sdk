    "url": "git+https://github.com/carriergrade/testlie-sdk.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/carriergrade/testlie-sdk/issues"
  },
  "keywords": [
    "testlie",
    "cli",
    "email-testing",
    "otp",
    "magic-link",
    "disposable-inbox",
    "e2e",
    "ci"
  ],
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "files": [
