# Where Testlie's client packages are published. Single source of truth:
#   scripts/release/set-org.sh <org>   rewrites every reference in the repo and this file
#   scripts/release/check.sh           (run in CI) fails if any file disagrees with these values
#
# GitHub org that owns the public repos (github.com/testlie is taken by an unrelated user).
PUBLIC_ORG=carriergrade
# Node SDK, the `testlie` CLI wrapper and the Python client. npm and PyPI publish from this repo:
# npm provenance only works from a public source repository.
SDK_REPO=testlie-sdk
# Go module at the repo root, so the import path is github.com/<org>/testlie-go.
GO_REPO=testlie-go
# GitHub Action with action.yml at the repo root (required for a Marketplace listing).
ACTION_REPO=testlie-action
# Registry names (all unclaimed when checked on 2026-10-17).
NPM_SDK=@testlie/sdk
NPM_CLI=testlie
PYPI_NAME=testlie
